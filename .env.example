# Copy this file to .env and fill in real values for local development.
# .env is already gitignored and must never be committed.

RADAR_EYE_DB_USER=
RADAR_EYE_DB_PASSWORD=
# Fernet key for encrypting credentials at rest (e.g. RTSP URLs). Generate
# with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
RADAR_EYE_ENCRYPTION_KEY=
# Secret used to sign/verify JWT auth tokens (apps/api/app/config.py's
# AuthSettings.jwt_secret, required, no default). Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
RADAR_EYE_JWT_SECRET=
RADAR_EYE_LOG_LEVEL=INFO
# Dedicated, disposable test database -- must be a database whose name
# ends in "_test", completely separate from the database above.
# DB-dependent tests fail immediately if this is unset (see conftest.py);
# they never derive their connection from the settings above.
RADAR_EYE_TEST_DATABASE_URL=

# RTSP camera credentials referenced by configs/camera.yaml via
# ${RADAR_CAMERA_USERNAME} / ${RADAR_CAMERA_PASSWORD}.
RADAR_CAMERA_USERNAME=
RADAR_CAMERA_PASSWORD=
